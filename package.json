{
  "name": "sakura-japanese",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "write:version": "node scripts/write_version.cjs",
    "build:web": "npm run write:version && vite build",
    "electron:dev": "set VITE_DEV_SERVER_URL=http://localhost:5173&& electron .",
    "build:win": "npm run build:web && electron-builder --win",
    "build:win:dir": "npm run build:web && electron-builder --win --dir",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build:web && npx cap sync android",
    "build:android": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "build:android:release": "npm run cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^5.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "build": {
    "appId": "com.sakura.japanese",
    "productName": "樱花日语",
    "copyright": "Copyright © 2026 Sakura Japanese",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "樱花日语",
      "artifactName": "sakura-japanese-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "by-be-young",
        "repo": "sakura-JLPT"
      }
    ]
  }
}

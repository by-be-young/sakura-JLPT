# 复制本文件为 .env.local 后填入你自己的值（.env.local 已被 .gitignore 忽略，不会进仓库）
#
# ⚠️ 只允许 anon public key / sb_publishable_...
#    绝不能填 service_role / secret key（数据库最高权限，会随安装包泄露给所有人）。
#    `npm run build` 会自动解码校验，填错直接构建失败。

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
